{
  "name": "@serpdive/ai-sdk",
  "version": "0.2.0",
  "description": "SERPdive web search tool for the Vercel AI SDK: real-time search returning extracted, answer-ready page content \u2014 20.2% fewer tokens than Tavily at the same speed, 60.7% of decided quality duels won on a public benchmark",
  "license": "MIT",
  "homepage": "https://serpdive.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serpdive/serpdive-ai-sdk.git"
  },
  "keywords": [
    "ai-sdk",
    "vercel-ai-sdk",
    "ai",
    "tool",
    "web-search",
    "search",
    "llm",
    "agents",
    "serpdive",
    "tavily-alternative"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "serpdive": "^0.1.0"
  },
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "ai": "^7.0.34",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.0.0"
  }
}
